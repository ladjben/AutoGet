function selectionIsOrderable() {
  const item = window.COSMOS_CONFIG?.products?.[selected];
  return item?.available === true && item?.price === 330000 && /^\d+$/.test(item?.variantId || '');
}
// Activer uniquement après le test complet du workflow publié.
const DIRECT_ORDERS_ENABLED = true;
const ORDER_ENDPOINT = 'https://n8n.ikleelcos.com/webhook/cosmos-offre-40-commandes';
const directForm = document.getElementById('cosmos-direct-form');
const submitButton = document.getElementById('cod-submit');
const directStatus = document.getElementById('cosmos-cod-status');
let sending = false, submitted = false, uncertain = false;
let requestId = null;
let frozenPayload = null;
const storageKey = 'cosmos40-pending-order-v1';
try { const saved=JSON.parse(sessionStorage.getItem(storageKey)||'null'); if(saved?.requestId){requestId=saved.requestId;uncertain=true;}} catch(e) {}
function refreshDirectForm(){
 if(!document.getElementById('cod-submit'))return;
 submitButton.disabled=!DIRECT_ORDERS_ENABLED||!selectionIsOrderable()||sending||submitted||uncertain;
 document.getElementById('sticky-order').disabled=submitted;
 if(!DIRECT_ORDERS_ENABLED)directStatus.textContent='الطلب غير متاح حاليا. عاود من بعد.';
 else if(uncertain)directStatus.textContent='عندك طلب راهو قيد التحقق. ما تعاودش تبعث طلب جديد.';
 else if(!selectionIsOrderable())directStatus.textContent='هذا الموديل ما راهوش متوفر حاليا.';
 else if(!sending&&!submitted)directStatus.textContent='';
}
function updateDelivery(){
 const home=directForm.elements.delivery.value==='home';
 document.getElementById('cod-shipping').textContent=home?'600':'400';
 document.getElementById('cod-total').textContent=home?'3 900 دج':'3 700 دج';
}
directForm.elements.delivery.addEventListener('change',updateDelivery);
document.getElementById('sticky-order').addEventListener('click',()=>{directForm.scrollIntoView({behavior:'smooth',block:'center'});directForm.elements.name.focus({preventScroll:true});});
directForm.addEventListener('submit',async event=>{
 event.preventDefault();
 if(personalMode){await submitPersonalOrder();return;}
 if(!DIRECT_ORDERS_ENABLED||sending||submitted||uncertain||!selectionIsOrderable()||!directForm.reportValidity())return;
 const fields=Object.fromEntries(new FormData(directForm));
 const phone=fields.phone.replace(/[\s().-]/g,'');
 if(!/^(0[567]\d{8}|\+213[567]\d{8})$/.test(phone)){directStatus.textContent='دخل رقم هاتف جزائري صحيح.';directForm.elements.phone.focus();return;}
 requestId=crypto.randomUUID();
 frozenPayload={...fields,phone,model:selected,quantity:1,requestId};
 try{sessionStorage.setItem(storageKey,JSON.stringify({requestId}));}catch(e){}
 sending=true;refreshDirectForm();submitButton.textContent='راه يتبعث الطلب…';directStatus.textContent='';
 document.querySelectorAll('[name="model"]').forEach(el=>el.disabled=true);
 const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),85000);
 try{
  const response=await fetch(ORDER_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(frozenPayload),signal:controller.signal,credentials:'omit'});
  const data=await response.json();
  if(response.ok&&data.ok===true&&data.orderName){submitted=true;try{sessionStorage.removeItem(storageKey);}catch(e){} directStatus.textContent='تسجّلت طلبيتك '+data.orderName+' — المجموع '+data.total+' دج. تخلّص كي توصلك.';submitButton.textContent='الطلبية تسجّلت ✓';}
  else if([400,403,409].includes(response.status)&&data.pending!==true){try{sessionStorage.removeItem(storageKey);}catch(e){}directStatus.textContent=data.message||'راجع المعلومات وعاود جرّب.';requestId=null;}
  else{uncertain=true;directStatus.textContent='ما قدرناش نأكدو النتيجة دُرك. ما تعاودش تبعث الطلب، تواصل مع COSMOS باش نتحققو.';}
 }catch(e){uncertain=true;directStatus.textContent='الاتصال تقطع وما قدرناش نأكدو النتيجة. ما تعاودش تبعث الطلب، تواصل مع COSMOS باش نتحققو.';}
 finally{clearTimeout(timer);sending=false;if(!submitted)submitButton.textContent=uncertain?'الطلب قيد التحقق':'نشري ضرك — الدفع عند الاستلام';submitButton.disabled=submitted||uncertain;document.querySelectorAll('[name="model"]').forEach(el=>{const item=window.COSMOS_CONFIG.products[el.value];el.disabled=submitted||uncertain||!item?.available||item?.price!==330000;});}
});
updateDelivery();
if (window.COSMOS_CONFIG?.checkoutReady) {
  document.querySelectorAll('[name="model"]').forEach(input => {
    const item = window.COSMOS_CONFIG.products[input.value];
    input.disabled = !item || !item.available || item.price !== 330000;
  });
  const first = document.querySelector('[name="model"]:not(:disabled)');
  if (first) { first.checked = true; selected = first.value; }
}
selectProduct(selected);
