const personalToken=window.COSMOS_PERSONAL_TOKEN;
let personalMode=false;
const personalSummary=document.createElement('p');
personalSummary.setAttribute('role','status');
personalSummary.style.cssText='padding:16px;background:#f3f3f3;border:1px solid #ddd;border-radius:8px;color:#111';
