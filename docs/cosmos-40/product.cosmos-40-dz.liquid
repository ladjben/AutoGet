changeContact.addEventListener('click',manualContact);
async function personalRequest(action,body){
 const response=await fetch(PERSONAL_API+'/'+action,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'omit',referrerPolicy:'no-referrer',body:JSON.stringify({token:personalToken,...body}),signal:AbortSignal.timeout(95000)});
 const data=await response.json();return {response,data};
}
async function submitPersonalOrder(){
 if(!DIRECT_ORDERS_ENABLED||sending||submitted||uncertain||!selectionIsOrderable()||!directForm.reportValidity())return;
 sending=true;refreshDirectForm();changeContact.disabled=true;submitButton.textContent='راه يتبعث الطلب…';
 document.querySelectorAll('[name="model"]').forEach(el=>el.disabled=true);
 try{
  const {response,data}=await personalRequest('confirm',{model:selected,delivery:directForm.elements.delivery.value});
  if(response.ok&&data.ok&&data.orderName){submitted=true;directStatus.textContent='تسجّلت طلبيتك '+data.orderName+' — المجموع '+data.total+' دج.';submitButton.textContent='الطلبية تسجّلت ✓';}
  else {uncertain=true;directStatus.textContent=data.error||'طلبك قيد التحقق. ما تعاودش تبعث طلب جديد، تواصل مع COSMOS.';submitButton.textContent='الطلب قيد التحقق';}
 }catch(e){uncertain=true;directStatus.textContent='ما قدرناش نأكدو النتيجة. تواصل مع COSMOS قبل ما تعاود تطلب.';}
 finally{sending=false;refreshDirectForm();}
}
async function loadPersonalContact(){
 if(!personalToken)return;
 sending=true;refreshDirectForm();personalSummary.hidden=false;personalSummary.textContent='راهي تتحمّل معلومات طلبيتك السابقة…';
 try{
  const {response,data}=await personalRequest('preview',{});
  if(response.ok&&data.state==='ready'){
   personalMode=true;addressConfirmation.hidden=false;addressConfirmation.querySelector('input').required=true;personalSummary.textContent='نستعملو معلومات طلبيتك السابقة: '+data.wilaya+' — رقمك يكمل بـ '+data.phoneEnding+'. أكّد بلي عنوانك ما تبدّلش، ولا اضغط باش تكتب المعلومات الجديدة.';
   contactFields.forEach(el=>{el.disabled=true;el.closest('label').hidden=true;});changeContact.hidden=false;
  }else if(response.ok&&data.state==='created'){
   submitted=true;personalSummary.textContent='هذا الرابط عندو طلبية مسجّلة '+(data.result?.orderName||'')+'.';
  }else if(response.ok&&['processing','review','failed'].includes(data.state)){
   uncertain=true;personalSummary.textContent='هذا الرابط عندو طلب قيد التحقق. تواصل مع COSMOS.';
  }else{personalSummary.textContent='ما قدرناش نجيبو المعلومات السابقة. عمّر المعلومات تاعك هنا.';}
 }catch(e){personalSummary.textContent='المعلومات السابقة ما راهيش متاحة. تقدر تعمّر الفورمولار.';}
 finally{sending=false;refreshDirectForm();}
}
loadPersonalContact();

</script></body></html>
