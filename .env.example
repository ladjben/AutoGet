# Existing browser configuration (public anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. NEVER prefix these with VITE_.
# Direct (not -pooler) Neon URL: session advisory locks coordinate workers.
MARKETING_DATABASE_URL=postgresql://ROLE:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
# ERP role has SELECT only on the contract view. May use a pooled Neon URL.
NEON_ERP_DATABASE_URL=postgresql://READ_ONLY_ROLE:PASSWORD@HOST/DATABASE?sslmode=verify-full
NEON_ERP_VIEW=autoget_marketing.delivered_items
MARKETING_ORIGIN=http://localhost:5173
MARKETING_PORT=3001
# Generate locally following docs/WHATSAPP_MARKETING.md
MARKETING_ADMIN_PASSWORD_HASH=
MARKETING_SESSION_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY=DZ
WHATSAPP_MESSAGES_PER_SECOND=1
# Enable explicitly only after configuration and review of your campaign.
WHATSAPP_SENDING_ENABLED=false
# Set production behind HTTPS; secure session cookies are then mandatory.
NODE_ENV=development

# Same secret in GitHub Actions; authenticates background batches.
CRON_SECRET=
