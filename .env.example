# Existing browser configuration (public anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. NEVER prefix these with VITE_.
# Existing AutoGet Supabase database: direct or Session pooler on 5432.
# Dedicated login belonging only to autoget_marketing_app (not postgres owner).
MARKETING_DATABASE_URL=postgresql://MARKETING_LOGIN:PASSWORD@SUPABASE_SESSION_HOST:5432/postgres?sslmode=verify-full
# IMPORT PROCESS ONLY — do not place these two values in Vercel.
NEON_ERP_DATABASE_URL=postgresql://READ_ONLY_ROLE:PASSWORD@NEON_HOST/neondb?sslmode=verify-full
MARKETING_SYNC_ENABLED=false
MARKETING_ORIGIN=http://localhost:5173
MARKETING_PORT=3001
# Generate locally following docs/WHATSAPP_MARKETING.md
MARKETING_ADMIN_PASSWORD_HASH=
MARKETING_SESSION_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY=DZ
WHATSAPP_MESSAGES_PER_SECOND=1
# Enable explicitly only after configuration and review of your campaign.
WHATSAPP_SENDING_ENABLED=false
# Set production behind HTTPS; secure session cookies are then mandatory.
NODE_ENV=development

# Same secret in GitHub Actions; authenticates background batches.
CRON_SECRET=
